def _get_today_jalali() -> jdatetime.date:
    now_local = timezone.localtime(timezone.now())
    return jdatetime.date.fromgregorian(date=now_local.date())


def _select_room_price_for_date(all_room_prices, target_date, user_level):
    """
    دقیقاً همسان با HotelRoomsView._select_price_for_date_from_memory:
    ۱) اولویت با رکورد تک‌روزه همان تاریخ، سپس رکورد بازه‌ای
    ۲) اولویت با سطح کاربری، سپس عمومی (جدیدترین id)
    """
    matching = [p for p in all_room_prices if p.start_date <= target_date <= p.end_date]
    if not matching:
        return None

    exact_day = [p for p in matching if p.start_date == target_date and p.end_date == target_date]
    candidates = exact_day if exact_day else matching

    if user_level:
        level_matches = [p for p in candidates if p.user_level_id == user_level.id]
        if level_matches:
            return max(level_matches, key=lambda x: x.id)

    public_matches = [p for p in candidates if p.user_level_id is None]
    if public_matches:
        return max(public_matches, key=lambda x: x.id)

    return None


def _calculate_unified_discount(price_data, target_date, hotel, today_j=None, fixed_discount_applied=False):
    """
    محاسبه واحد تخفیف همسان با HotelRoomsView.calculate_discount:
    ۱) تخفیف درصدی اتاق (تا پایان روز discount_date)
    ۲) تخفیف ثابت اتاق (با پشتیبانی از یک‌بار اعمال)
    ۳) تخفیف لحظه‌آخری هتل (hotel.get_active_last_minute_info وقتی has_hotel_last_minute فعال باشد)
    """
    if not price_data or price_data.price is None:
        return 0, None, None, None, 'none', fixed_discount_applied, False, 0

    if today_j is None:
        today_j = _get_today_jalali()

    base_price = int(price_data.price)
    discount_amount = 0
    price_after_discount = base_price
    discount_percentage = None
    discount_date_str = None
    effective_discount_type = 'none'
    is_last_minute = False
    timer_seconds = 0

    if price_data.discount_type == 'percentage' and (price_data.discount_value or 0) > 0:
        if price_data.discount_date and price_data.discount_date >= today_j:
            discount_amount = int(round(base_price * price_data.discount_value / 100))
            discount_percentage = int(price_data.discount_value)
            discount_date_str = price_data.discount_date.strftime('%Y/%m/%d')
            price_after_discount = int(max(base_price - discount_amount, 0))
            effective_discount_type = 'percentage'

            end_dt_g = (
                price_data.discount_date.togregorian()
                if hasattr(price_data.discount_date, 'togregorian')
                else price_data.discount_date
            )
            comb = datetime.combine(end_dt_g, dtime(23, 59, 59))
            current_tz = timezone.get_current_timezone()
            aware_comb = timezone.make_aware(comb, current_tz) if timezone.is_naive(comb) else comb
            now_local = timezone.localtime(timezone.now())
            timer_seconds = max(0, int((aware_comb - now_local).total_seconds()))

            if getattr(price_data, 'is_last_minute', False) and timer_seconds > 0:
                is_last_minute = True

            return (
                discount_amount,
                price_after_discount,
                discount_percentage,
                discount_date_str,
                effective_discount_type,
                fixed_discount_applied,
                is_last_minute,
                timer_seconds,
            )

    elif price_data.discount_type == 'fixed' and (price_data.discount_value or 0) > 0:
        if price_data.discount_date:
            raise ValueError("تخفیف ثابت نمی‌تواند تاریخ انقضا داشته باشد.")
        if price_data.is_fixed_discount_one_time and fixed_discount_applied:
            discount_amount = 0
        else:
            discount_amount = int(price_data.discount_value)
            fixed_discount_applied = price_data.is_fixed_discount_one_time
        price_after_discount = int(max(base_price - discount_amount, 0))
        effective_discount_type = 'fixed' if discount_amount > 0 else 'none'
        return (
            discount_amount,
            price_after_discount,
            None,
            None,
            effective_discount_type,
            fixed_discount_applied,
            False,
            0,
        )

    if hotel:
        try:
            lm_active, lm_pct, lm_sec = hotel.get_active_last_minute_info(target_date)
        except Exception:
            lm_active, lm_pct, lm_sec = False, 0, 0

        if lm_active and (lm_pct or 0) > 0 and getattr(price_data, 'has_hotel_last_minute', False):
            discount_amount = int(round(base_price * lm_pct / 100))
            discount_percentage = int(lm_pct)
            price_after_discount = int(max(base_price - discount_amount, 0))
            effective_discount_type = 'percentage'
            is_last_minute = True
            timer_seconds = int(lm_sec or 0)

    return (
        discount_amount,
        price_after_discount,
        discount_percentage,
        discount_date_str,
        effective_discount_type,
        fixed_discount_applied,
        is_last_minute,
        timer_seconds,
    )


def _build_hotels_today_min_price_map(hotels, user_level=None, include_without_price=False):
    """
    محاسبه کمترین قیمت نهایی واقعی امروز برای لیستی از هتل‌ها
    با لحاظ تخفیف ثابت، تخفیف درصدی، لحظه‌آخری هتل، اولویت رکورد تک‌روزه و روزهای بسته.
    """
    today_j = _get_today_jalali()
    hotels_list = list(hotels)
    if not hotels_list:
        return {}, []

    hotel_ids = [h.id for h in hotels_list]
    rooms_qs = list(
        Room.objects.filter(hotel_id__in=hotel_ids, inventory__gt=0)
        .prefetch_related('date_prices__user_level')
    )

    rooms_by_hotel = {}
    for rm in rooms_qs:
        rooms_by_hotel.setdefault(rm.hotel_id, []).append(rm)

    room_ids = [rm.id for rm in rooms_qs]
    closed_room_ids = set(
        ClosedDate.objects.filter(
            room_date__room_id__in=room_ids,
            date=today_j,
        ).values_list('room_date__room_id', flat=True)
    ) if room_ids else set()

    hotel_min_price_map = {}
    valid_hotels = []

    for hotel in hotels_list:
        if hasattr(hotel, 'check_and_expire_last_minute'):
            try:
                hotel.check_and_expire_last_minute()
            except Exception:
                pass

        active_rooms = rooms_by_hotel.get(hotel.id, [])
        if not active_rooms:
            continue

        min_price = float('inf')
        min_price_data = None

        for room in active_rooms:
            if room.id in closed_room_ids:
                continue

            all_room_prices = list(room.date_prices.all())
            price_data = _select_room_price_for_date(all_room_prices, today_j, user_level)
            if not price_data or not price_data.price or price_data.price <= 0:
                continue

            try:
                (
                    disc_amt,
                    final_price,
                    disc_pct,
                    disc_date_str,
                    eff_disc_type,
                    _,
                    is_lm,
                    timer_sec,
                ) = _calculate_unified_discount(
                    price_data,
                    today_j,
                    hotel,
                    today_j=today_j,
                    fixed_discount_applied=False,
                )
            except ValueError:
                continue

            if final_price is None or final_price <= 0:
                continue

            base_price = int(price_data.price)
            if final_price < min_price:
                min_price = final_price
                has_discount = final_price < base_price
                if disc_pct is not None:
                    effective_pct = int(disc_pct)
                elif has_discount and base_price > 0:
                    effective_pct = round(((base_price - final_price) / base_price) * 100, 1)
                else:
                    effective_pct = 0

                min_price_data = {
                    'total_price': int(final_price),
                    'original_total_price': base_price if has_discount else None,
                    'discount_type': eff_disc_type,
                    'discount_value': int(disc_pct) if eff_disc_type == 'percentage' and disc_pct is not None else (int(disc_amt) if eff_disc_type == 'fixed' else 0),
                    'discount_percentage': effective_pct,
                    'discount_date': disc_date_str,
                    'timer_seconds': timer_sec,
                    'is_last_minute': is_lm,
                    'user_level': price_data.user_level.title if price_data.user_level else "عمومی",
                    'has_price': True,
                    'is_accessible': True,
                }

        if min_price_data:
            hotel_min_price_map[hotel.id] = min_price_data
            valid_hotels.append(hotel)
        elif include_without_price:
            hotel_min_price_map[hotel.id] = {
                'total_price': None,
                'original_total_price': None,
                'discount_type': 'none',
                'discount_value': 0,
                'discount_percentage': 0,
                'discount_date': None,
                'timer_seconds': 0,
                'is_last_minute': False,
                'user_level': "بدون قیمت",
                'has_price': False,
                'is_accessible': False,
            }
            valid_hotels.append(hotel)

    return hotel_min_price_map, valid_hotels


class BaseHotelListView(APIView):
    permission_classes = (AllowAny,)

    def get_average_score(self, hotel):
        comments = Comment.objects.filter(hotel=hotel, is_approved=True)
        if not comments.exists():
            return 0.0
        all_points = CommentPoint.objects.filter(comment__in=comments)
        overall_average = all_points.aggregate(avg=Avg("point"))["avg"]
        return round(overall_average or 0, 1)

    def get_hotel_min_price_map(self, hotels, user_level=None):
        hotel_min_price_map, _ = _build_hotels_today_min_price_map(
            hotels,
            user_level=user_level,
            include_without_price=False,
        )
        return hotel_min_price_map

    def get(self, request, *args, **kwargs):
        user_level = None
        if request.user.is_authenticated:
            try:
                profile = request.user.natural_profile
                if profile and profile.level:
                    user_level = profile.level
            except Exception as e:
                logger.warning(f"User level fetch failed: {e}")

        hotels = self.get_queryset()
        hotel_min_price_map = self.get_hotel_min_price_map(hotels, user_level)

        context = {
            'hotel_min_price_map': hotel_min_price_map,
            'request': request
        }
        serializer = HotelListSerializer(hotels, many=True, context=context)
        return Response(serializer.data)


class SuggesteHotelListView(BaseHotelListView):
    @swagger_auto_schema(
        operation_summary="دریافت لیست هتل‌های پیشنهادی",
        tags=['hotel-home'],
    )
    def get(self, request, *args, **kwargs):
        hotels = Hotel.objects.filter(status='published', is_special_offer=True).select_related('city', 'type').distinct()
        if not hotels.exists():
            return Response([])

        user_level = None
        if request.user.is_authenticated:
            try:
                profile = request.user.natural_profile
                if profile and profile.level:
                    user_level = profile.level
            except Exception as e:
                logger.warning(f"User level fetch failed in SuggesteHotelListView: {e}")

        hotel_min_price_map, valid_hotels = _build_hotels_today_min_price_map(
            hotels,
            user_level=user_level,
            include_without_price=True,
        )

        context = {'hotel_min_price_map': hotel_min_price_map, 'request': request}
        special_offers_data = []

        for hotel in valid_hotels:
            serialized = HotelListSerializer(hotel, context=context).data
            serialized['average_score'] = self.get_average_score(hotel)
            price_info = hotel_min_price_map.get(hotel.id, {})
            serialized['price_info'] = price_info

            if price_info and price_info.get('has_price'):
                serialized['total_price'] = price_info.get('total_price')
                serialized['min_price'] = price_info.get('total_price')
                serialized['price'] = price_info.get('total_price')
                serialized['original_total_price'] = price_info.get('original_total_price')
                serialized['discount_percentage'] = price_info.get('discount_percentage', 0)
                serialized['discount_expiry'] = price_info.get('discount_date')

            special_offers_data.append(serialized)

        return Response(special_offers_data)


